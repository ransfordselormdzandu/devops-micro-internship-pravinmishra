# Copy to terraform.tfvars and update before running terraform plan.
aws_region          = "us-east-1"
project_name        = "azure-static-website-cicd"
instance_type       = "t3.micro" # Check account eligibility and pricing.
ssh_public_key_path = "~/.ssh/id_ed25519.pub"
admin_ssh_cidr      = "203.0.113.10/32" # Replace with YOUR workstation's public IPv4 /32.
agent_ssh_cidr      = "198.51.100.20/32" # Replace with the agent VM's PUBLIC outbound IPv4 /32.
root_volume_size_gb = 12
